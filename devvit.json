{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "modos",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "console": {
        "entry": "console.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Open MODOS Console",
        "description": "Open the MODOS moderation console",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/open-console"
      },
      {
        "label": "Seed MODOS demo data",
        "description": "Generate a realistic moderation scenario for the demo",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/seed-demo"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  }
}
